// Prisma-Schema für das Kurzlink- und Tracking-System.
// Datenbank: PostgreSQL (anbieterunabhängig über DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rolle eines Dashboard-Benutzers. Rechteumfang zentral in src/lib/permissions.ts.
enum UserRole {
  ADMIN
  MARKETER
  VIEWER
}

/// Dashboard-Benutzer mit E-Mail + bcrypt-Passwort-Hash.
/// Der Env-Admin (ADMIN_EMAIL/ADMIN_PASSWORD_HASH) bleibt als Bootstrap-Zugang
/// bestehen, damit die erste Anmeldung ohne Datenbank-Benutzer möglich ist.
model User {
  id           String    @id @default(cuid())
  /// Immer kleingeschrieben gespeichert (wird in der Anwendung erzwungen).
  email        String    @unique
  name         String?
  passwordHash String
  role         UserRole  @default(VIEWER)
  active       Boolean   @default(true)
  /// Sessions mit iat vor diesem Zeitpunkt sind ungültig (gesetzt bei
  /// Passwort-Änderung/-Reset → sofortige Abmeldung alter Sitzungen).
  sessionsValidFrom DateTime? @db.Timestamptz(3)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([active])
}

/// Wiederverwendbare Ziel-URL (beliebige HTTPS-Ziele). Mehrere Kurzlinks
/// können auf dieselbe Destination zeigen.
model Destination {
  id        String   @id @default(cuid())
  /// Interne Bezeichnung, z. B. "Amazon Buchseite (DE)"
  name      String
  /// Vollständige HTTPS-Ziel-URL (optional per Allowlist beschränkbar)
  url       String
  /// Hostname des Ziels, z. B. "www.amazon.de" (denormalisiert für Anzeige/Filter)
  host      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  shortLinks ShortLink[]

  @@index([active])
}

/// Kurzlink mit exakt vier Kleinbuchstaben als Code.
/// Der Code ist nach Erstellung unveränderlich (wird in der Anwendung erzwungen).
model ShortLink {
  id            String    @id @default(cuid())
  /// Exakt 4 Kleinbuchstaben a-z, kryptografisch zufällig, eindeutig.
  code          String    @unique @db.VarChar(4)
  /// Interner Linkname, z. B. "Instagram Profil Bio"
  name          String
  source        String
  medium        String?
  campaign      String?
  content       String?
  note          String?
  active        Boolean   @default(true)
  expiresAt     DateTime? @db.Timestamptz(3)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  clickEvents ClickEvent[]

  @@index([destinationId])
  @@index([active])
  @@index([source])
  @@index([campaign])
}

/// Serverseitig erfasster Aufruf eines Kurzlinks.
/// Zeitstempel werden ausschließlich in UTC gespeichert; die Anzeige erfolgt
/// in Europe/Berlin. Es werden keine vollständigen IP-Adressen gespeichert.
model ClickEvent {
  /// Sichere, serverseitig erzeugte Event-ID (UUID v4).
  id            String   @id
  shortLinkId   String
  shortLink     ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  code          String   @db.VarChar(4)
  destinationId String
  ts            DateTime @default(now()) @db.Timestamptz(3)

  // Kopien der Link-Metadaten zum Zeitpunkt des Klicks (stabil für Auswertungen)
  linkName String
  source   String
  medium   String?
  campaign String?
  content  String?

  // Request-Daten (datensparsam)
  referrer   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  deviceType String?
  browser    String?
  os         String?
  country    String?
  region     String?
  city       String?
  /// Ungefähre Geokoordinaten aus den Vercel-Headern, auf eine Nachkommastelle
  /// gerundet (~11 km, Stadt-Niveau – Datensparsamkeit, keine Präzisionsdaten).
  latitude   Float?
  longitude  Float?

  // Bot-Klassifizierung
  isBot     Boolean @default(false)
  botReason String?

  /// Nicht rückrechenbarer, täglich rotierender HMAC-Hash für Unique-Visitor-Zählung.
  visitorHash String?

  /// Lag zum Zeitpunkt des Klicks eine gültige Marketing-Einwilligung vor?
  consent Boolean @default(false)

  // Clientseitige Bestätigungen (nur mit gültigem signiertem Event-Token setzbar)
  bridgeLoaded    Boolean @default(false)
  trackingFired   Boolean @default(false)
  redirectStarted Boolean @default(false)
  manualClick     Boolean @default(false)

  @@index([ts])
  @@index([shortLinkId, ts])
  @@index([isBot, ts])
  @@index([code])
  @@index([source])
  @@index([campaign])
  @@index([destinationId])
  @@index([visitorHash])
}

/// Tagesaggregat für langfristige Statistiken. Bleibt erhalten, wenn alte
/// detaillierte ClickEvents durch die Retention gelöscht werden.
model DailyAggregate {
  id          String   @id @default(cuid())
  /// Kalendertag in Europe/Berlin (als UTC-Mitternacht des lokalen Datums gespeichert)
  date        DateTime @db.Date
  shortLinkId String?
  code        String?
  source      String?
  campaign    String?
  humanClicks Int      @default(0)
  botClicks   Int      @default(0)
  uniqueVisitors Int   @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([date, shortLinkId])
  @@index([date])
}

/// Audit-Log für alle relevanten Admin-Aktionen.
model AuditLog {
  id         String   @id @default(cuid())
  ts         DateTime @default(now()) @db.Timestamptz(3)
  actor      String
  action     String
  entityType String
  entityId   String?
  /// JSON mit den geänderten Feldern (keine Secrets)
  changes    Json?

  @@index([ts])
  @@index([entityType, entityId])
}

/// Status einer Gewinnspiel-Teilnahme (Anzeige-Labels in lib/gewinnspiel-config.ts).
enum SweepstakesEntryStatus {
  RECEIVED
  IN_REVIEW
  REVIEWED
  INVALID
  WINNER
  NOT_WON
  DELETED
}

/// Teilnahme am Buch-Gewinnspiel (Landingpage /gewinn).
/// Personenbezogene Felder werden bei Anonymisierung geleert; Referenz und
/// Bestellnummern-Hash bleiben erhalten (verhindert erneute Registrierung).
model SweepstakesEntry {
  /// UUID v4 (serverseitig erzeugt)
  id              String @id
  /// Öffentliche Teilnahme-Referenz, z. B. "K7M2X9AB" (8 Zeichen)
  referenceNumber String @unique
  /// Händler-Kennung (amazon | thalia | hugendubel | buecher_de | other)
  retailer        String
  /// Name des Händlers bei retailer = "other"
  retailerOther   String?

  /// HMAC-SHA256 der normalisierten Bestellnummer (Duplikaterkennung).
  /// Global eindeutig: eine Bestellnummer kann nur einmal teilnehmen.
  orderNumberHash      String @unique
  /// AES-256-GCM-verschlüsselte Original-Bestellnummer (für spätere Prüfung)
  orderNumberEncrypted String

  firstName   String
  lastName    String
  street      String
  houseNumber String
  postalCode  String
  city        String
  country     String
  email       String
  phone       String

  // Nachweis der Pflichtbestätigungen inkl. verwendeter Versionen
  confirmedAccuracyAt   DateTime @db.Timestamptz(3)
  acceptedTermsAt       DateTime @db.Timestamptz(3)
  termsVersion          String
  acknowledgedPrivacyAt DateTime @db.Timestamptz(3)
  privacyVersion        String

  status       SweepstakesEntryStatus @default(RECEIVED)
  internalNote String?

  // Serverseitig erfasste Herkunft (keine Weitergabe an Drittanbieter)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  referrer    String?
  landingHost String?

  /// Nicht rückrechenbarer HMAC-Hash (IP + User-Agent) für Rate Limiting
  /// und Duplikat-Indizien – bewusst keine IP-Speicherung.
  submissionIdentifier String?

  /// Gesetzt, sobald eine Bestätigungs-E-Mail tatsächlich versendet wurde.
  emailConfirmationSentAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([retailer])
  @@index([createdAt])
  @@index([email])
  @@index([lastName])
  @@index([submissionIdentifier, createdAt])
}

/// Event aus dem zentralen Tracking-Snippet (t.js) einer angebundenen Website.
/// Datensparsam: keine IPs, keine Query-Strings (außer extrahierter UTM),
/// Besucher nur als rotierender HMAC bzw. HMAC der First-Party-Cookie-ID.
model TagEvent {
  /// UUID – identisch mit der eventID des Browser-Pixels (CAPI-Deduplication)
  id        String @id
  siteId    String
  eventName String
  /// URL ohne Query-String
  url  String
  path String
  referrer String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  country String?
  region  String?
  city    String?

  deviceType String?
  browser    String?
  os         String?

  /// Täglich rotierender HMAC aus IP+UA (wie ClickEvent.visitorHash)
  visitorHash String?
  /// HMAC der First-Party-Cookie-ID (_lze_id) – Journey über Tage hinweg
  cookieHash String?

  isBot Boolean @default(false)

  /// Zeitpunkte erfolgreicher Server-Weiterleitungen (Conversion APIs)
  metaForwardedAt   DateTime? @db.Timestamptz(3)
  tiktokForwardedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([siteId, createdAt])
  @@index([eventName, createdAt])
  @@index([createdAt])
  @@index([cookieHash])
}

/// Konfiguration einer an TRACK.SITE angebundenen Website: Domains,
/// Pixel-IDs und Conversion-API-Tokens (Tokens AES-256-GCM-verschlüsselt).
/// Nicht gesetzte Felder fallen auf die globalen Env-Werte zurück.
model TagSiteConfig {
  /// Site-ID (Slug, Teil des Snippets: /t.js?site=ID)
  id     String  @id
  label  String
  /// Komma-separierte Domain-Allowlist (Subdomains automatisch inklusive)
  domains String
  active  Boolean @default(true)

  ga4MeasurementId String?
  gtmContainerId   String?
  metaPixelId      String?
  /// verschlüsselt – niemals im Klartext ausgeben
  metaCapiTokenEncrypted String?
  tiktokPixelId          String?
  /// verschlüsselt – niemals im Klartext ausgeben
  tiktokTokenEncrypted String?
  redditPixelId        String?
  linkedinPartnerId    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Einfache Key-Value-Einstellungen der Anwendung (z. B. Redirect-Verzögerung).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Fehlgeschlagene und erfolgreiche Loginversuche für Rate Limiting.
/// Enthält keine IP-Adressen, sondern nur einen HMAC-Hash.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// HMAC-Hash der Client-Kennung (IP + User-Agent), nicht rückrechenbar
  identifier String
  success    Boolean
  ts         DateTime @default(now()) @db.Timestamptz(3)

  @@index([identifier, ts])
}

// ============================================================================
// Modul "Amazon Buchrankings"
// Alle Zeitstempel UTC; Anzeige Europe/Berlin. Ränge: kleiner = besser,
// niemals 0 – fehlende Ränge sind NULL. Secrets werden hier nie gespeichert.
// ============================================================================

/// Datenprovider einer Beobachtung.
enum AmazonProviderKind {
  CREATORS
  RAINFOREST
  MANUAL
}

/// Herkunftsstatus einer Messung. Eine fehlgeschlagene Messung wird NICHT
/// gespeichert – CACHED/MANUAL kennzeichnen bewusst übernommene Altwerte.
enum AmazonSourceStatus {
  LIVE
  PARTIAL
  CACHED
  MANUAL
}

/// Ergebnis eines Provider-/Job-Laufs.
enum AmazonRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

/// Logisches Buch (unabhängig von einzelnen Ausgaben/ASINs).
model AmazonBook {
  id               String   @id @default(cuid())
  title            String
  subtitle         String?
  author           String
  publisher        String?
  language         String?
  description      String?
  /// Edition, die in Übersichten standardmäßig gezeigt wird
  primaryEditionId String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  editions AmazonEdition[]

  @@index([active])
}

/// ASIN-spezifische Ausgabe eines Buchs (Taschenbuch, Kindle, Hörbuch …).
/// Ränge werden niemals editionsübergreifend zusammengerechnet.
model AmazonEdition {
  id          String     @id @default(cuid())
  bookId      String
  book        AmazonBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  marketplace String     @default("www.amazon.de")
  asin        String
  parentAsin  String?
  isbn10      String?
  isbn13      String?
  /// z. B. "Taschenbuch", "Kindle", "Hardcover", "Hörbuch"
  format          String
  publicationDate DateTime? @db.Date
  /// Vorbestellphase (wird bei Statuswechsel per Alert gemeldet)
  preorder        Boolean   @default(true)
  /// Startpunkt "seit Vorbestellstart" für Bestwert-Auswertungen
  preorderStartAt DateTime? @db.Timestamptz(3)

  /// ASIN wurde über mindestens einen Provider bestätigt
  asinValidated           Boolean             @default(false)
  asinValidatedAt         DateTime?           @db.Timestamptz(3)
  asinValidationProvider  AmazonProviderKind?

  productUrl      String?
  affiliateUrl    String?
  /// Code eines vorhandenen Kurzlinks (z. B. "wulp") für die Klick-Verknüpfung
  trackedShortCode String? @db.VarChar(4)

  coverSmallUrl  String?
  coverMediumUrl String?
  coverLargeUrl  String?
  coverWidth     Int?
  coverHeight    Int?

  currentPrice        Decimal? @db.Decimal(10, 2)
  currency            String?
  currentAvailability String?
  currentRating       Float?
  currentReviewCount  Int?

  metadataProvider   AmazonProviderKind?
  metadataObservedAt DateTime?           @db.Timestamptz(3)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  categories        AmazonEditionCategory[]
  rankObservations  AmazonRankObservation[]
  canonicalSnapshots AmazonCanonicalRankSnapshot[]
  metadataSnapshots AmazonProductMetadataSnapshot[]
  salesEstimates    AmazonSalesEstimate[]
  actualSalesImports AmazonActualSalesImport[]

  @@unique([marketplace, asin])
  @@index([bookId])
  @@index([active])
}

/// Beobachtete Kategorie. categoryType:
///   WEBSITE     – Pseudo-Kategorie für den Gesamtbuchrang (websiteSalesRank)
///   BROWSE_NODE – Amazon Browse Node (Kategorierang des eigenen Buchs)
///   BESTSELLERS – Rainforest-Bestsellerkategorie (Top-25-Listen)
model AmazonCategory {
  id             String  @id @default(cuid())
  marketplace    String  @default("www.amazon.de")
  canonicalName  String
  /// kleingeschriebener Vergleichsname
  normalizedName String
  path           String?
  parentId       String?
  categoryType   String  @default("BROWSE_NODE")
  isRoot         Boolean @default(false)
  /// Pflichtkategorie (z. B. Sachbücher) – darf nicht deaktiviert werden
  required       Boolean @default(false)
  /// Automatisch aufgenommene Kategorien weiter beobachten
  autoFollow     Boolean @default(true)
  leaderboardEnabled Boolean @default(false)
  leaderboardLimit   Int     @default(25)
  /// Minuten; NULL = globales Intervall
  refreshIntervalOverride Int?
  active           Boolean   @default(true)
  lastResolvedAt   DateTime? @db.Timestamptz(3)
  /// unresolved | resolved | ambiguous | failed
  resolutionStatus String    @default("unresolved")
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  providerMappings   AmazonCategoryProviderMapping[]
  editionCategories  AmazonEditionCategory[]
  rankObservations   AmazonRankObservation[]
  canonicalSnapshots AmazonCanonicalRankSnapshot[]
  leaderboardSnapshots AmazonLeaderboardSnapshot[]

  @@index([marketplace, normalizedName])
  @@index([active])
  @@index([categoryType])
}

/// Verknüpfung interner Kategorien mit den Provider-IDs
/// (Amazon Browse Node ↔ Rainforest-Bestsellerkategorie).
model AmazonCategoryProviderMapping {
  id                       String             @id @default(cuid())
  categoryId               String
  category                 AmazonCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  provider                 AmazonProviderKind
  providerCategoryId       String
  providerCategoryName     String?
  providerCategoryPath     String?
  providerCategoryUrl      String?
  parentProviderCategoryId String?
  /// Vom Admin bestätigt (Sachbücher-Auflösung zeigt volle Pfade zur Auswahl)
  verified   Boolean   @default(false)
  verifiedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([categoryId, provider, providerCategoryId])
  @@index([provider, providerCategoryId])
}

/// In welchen Kategorien eine Edition (jemals) gerankt wurde.
model AmazonEditionCategory {
  id                String              @id @default(cuid())
  editionId         String
  edition           AmazonEdition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  categoryId        String
  category          AmazonCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  discoveryProvider AmazonProviderKind?
  autoDiscovered    Boolean             @default(false)
  currentlyRanked   Boolean             @default(false)
  firstSeenAt       DateTime            @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime            @default(now()) @db.Timestamptz(3)
  active            Boolean             @default(true)

  @@unique([editionId, categoryId])
  @@index([categoryId])
}

/// Einzelne Rangbeobachtung eines Providers (Rohzeitreihe, getrennt je Provider).
model AmazonRankObservation {
  id         String             @id @default(cuid())
  editionId  String
  edition    AmazonEdition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  categoryId String
  category   AmazonCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Positiver Rang; NULL = Provider hat keinen Rang geliefert. Niemals 0.
  rank              Int?
  provider          AmazonProviderKind
  providerPriority  Int                @default(0)
  /// Zeitstempel laut Provider (falls geliefert) – nicht mit fetchedAt verwechseln
  providerUpdatedAt DateTime?          @db.Timestamptz(3)
  /// Messzeitpunkt der Zeitreihe (Bucket)
  observedAt DateTime           @db.Timestamptz(3)
  /// Tatsächlicher Abrufzeitpunkt
  fetchedAt  DateTime           @db.Timestamptz(3)
  freshnessSeconds Int?
  sourceStatus     AmazonSourceStatus @default(LIVE)
  canonical        Boolean            @default(false)
  discrepancyFlag  Boolean            @default(false)
  /// Absolute Abweichung zum jeweils anderen Provider (falls vergleichbar)
  providerDifference Int?
  runId       String?
  payloadHash String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([editionId, categoryId, provider, observedAt])
  @@index([editionId, categoryId, observedAt])
  @@index([observedAt])
  @@index([runId])
}

/// Kanonischer Rang pro Messzeitpunkt (Auswahl aus beiden Providern).
model AmazonCanonicalRankSnapshot {
  id         String         @id @default(cuid())
  editionId  String
  edition    AmazonEdition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  categoryId String
  category   AmazonCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// NULL = Datenlücke (kein Provider und kein Vorwert)
  canonicalRank    Int?
  selectedProvider AmazonProviderKind?
  /// z. B. "creators_fresh", "rainforest_fallback", "stale_last_value", "data_gap"
  selectionReason String
  observedAt      DateTime @db.Timestamptz(3)
  stale           Boolean  @default(false)
  dataGap         Boolean  @default(false)
  amazonObservationId     String?
  rainforestObservationId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([editionId, categoryId, observedAt])
  @@index([editionId, categoryId, observedAt])
}

/// Top-25-Bestsellerlisten-Snapshot einer Kategorie.
model AmazonLeaderboardSnapshot {
  id         String         @id @default(cuid())
  categoryId String
  category   AmazonCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  provider   AmazonProviderKind
  observedAt        DateTime  @db.Timestamptz(3)
  providerUpdatedAt DateTime? @db.Timestamptz(3)
  fetchedAt         DateTime  @db.Timestamptz(3)
  requestedLimit    Int       @default(25)
  returnedCount     Int
  complete          Boolean   @default(true)
  partialReason     String?
  stale             Boolean   @default(false)
  runId             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  entries AmazonLeaderboardEntry[]

  @@index([categoryId, observedAt])
}

/// Einzelner Eintrag eines Leaderboard-Snapshots (Reihenfolge wie geliefert).
model AmazonLeaderboardEntry {
  id         String                    @id @default(cuid())
  snapshotId String
  snapshot   AmazonLeaderboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  /// Position im gelieferten Ergebnis (1-basiert, Reihenfolge unverändert)
  position Int
  /// Bestseller-Rang laut Amazon
  bestsellerRank Int
  asin           String
  /// Interne Edition, falls bekannt (eigenes Buch → Hervorhebung)
  editionId          String?
  titleSnapshot      String
  subTitleSnapshot   String?
  authorSnapshot     String?
  formatSnapshot     String?
  imageUrlSnapshot   String?
  productUrlSnapshot String?
  affiliateUrlSnapshot String?
  priceSnapshot      Decimal? @db.Decimal(10, 2)
  currencySnapshot   String?
  priceRawSnapshot   String?
  ratingSnapshot     Float?
  reviewCountSnapshot Int?
  preorderSnapshot   Boolean?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@unique([snapshotId, position])
  @@index([asin])
}

/// Metadaten-Snapshot (Preis/Verfügbarkeit/Bewertung/Cover) je Provider.
model AmazonProductMetadataSnapshot {
  id        String        @id @default(cuid())
  editionId String
  edition   AmazonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  provider  AmazonProviderKind
  title     String?
  author    String?
  coverSmallUrl  String?
  coverMediumUrl String?
  coverLargeUrl  String?
  price        Decimal? @db.Decimal(10, 2)
  currency     String?
  availability String?
  rating       Float?
  reviewCount  Int?
  preorder     Boolean?
  observedAt   DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([editionId, observedAt])
}

/// Laufhistorie aller Provider-/Job-Ausführungen (niemals Secrets).
model AmazonProviderRun {
  id         String              @id @default(cuid())
  provider   AmazonProviderKind?
  capability String?
  jobType    String
  scheduledAt DateTime? @db.Timestamptz(3)
  startedAt   DateTime  @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  status      AmazonRunStatus @default(RUNNING)
  attempt     Int             @default(1)
  requestCount     Int  @default(0)
  recordsRequested Int?
  recordsReturned  Int?
  creditsUsed      Int?
  creditsRemaining Int?
  latencyMs        Int?
  fallbackFrom     AmazonProviderKind?
  errorClass       String?
  errorCode        String?
  /// Redigierte, sichere Fehlermeldung (ohne Secrets/URLs mit Key)
  safeErrorMessage String?
  httpStatus       Int?
  correlationId    String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([jobType, startedAt])
  @@index([provider, startedAt])
  @@index([correlationId])
}

/// Aktueller Zustand je Provider (Health, Circuit Breaker, Quota).
model AmazonProviderStatus {
  provider   AmazonProviderKind @id
  configured Boolean            @default(false)
  enabled    Boolean            @default(true)
  healthy    Boolean            @default(false)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  lastFailureAt DateTime? @db.Timestamptz(3)
  consecutiveFailures Int    @default(0)
  /// closed | open | half_open
  circuitBreakerState String @default("closed")
  circuitOpenedAt     DateTime? @db.Timestamptz(3)
  currentLatencyMs    Int?
  /// Redigierter Quota-/Account-Status (Rainforest: Plan/Credits, nie api_key)
  quota     Json?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Scheduler-Zustand je Hintergrundjob (verteilter Lock über lockedUntil).
model AmazonJobState {
  jobType         String    @id
  enabled         Boolean   @default(true)
  /// Minuten; NULL = Standard aus Settings/Env
  intervalMinutes Int?
  nextRunAt       DateTime? @db.Timestamptz(3)
  lockedUntil     DateTime? @db.Timestamptz(3)
  lockOwner       String?
  lastRunAt       DateTime? @db.Timestamptz(3)
  lastStatus      AmazonRunStatus?
  lastRunId       String?
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

/// Redigierte Provider-Rohantwort (Fehlersuche; Aufbewahrung max. 30 Tage).
model AmazonRawPayload {
  id         String             @id @default(cuid())
  provider   AmazonProviderKind
  capability String
  runId      String?
  /// Redigiert: keine api_keys, Tokens oder E-Mail-Adressen
  payload     Json
  payloadHash String
  fetchedAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([provider, capability, fetchedAt])
}

/// Konfigurierbare Alert-Regel.
model AmazonAlertRule {
  id         String  @id @default(cuid())
  name       String
  /// edition | category | provider | system
  targetType String
  editionId  String?
  categoryId String?
  /// z. B. "rank_below", "movement_positions", "movement_percent",
  /// "new_best", "top_entry", "leaderboard_exit", "credits_below_percent",
  /// "stale_hours", "provider_down", "price_changed", "preorder_changed"
  metric    String
  /// lt | lte | gt | gte | eq
  operator  String   @default("lte")
  threshold Decimal? @db.Decimal(12, 4)
  /// Komma-separierte Kanäle: inapp,email
  channels        String   @default("inapp")
  cooldownMinutes Int      @default(360)
  enabled         Boolean  @default(true)
  lastTriggeredAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  events AmazonAlertEvent[]

  @@index([enabled])
}

/// Ausgelöste Alerts (Historie, Dedupe über dedupeKey + Cooldown).
model AmazonAlertEvent {
  id     String           @id @default(cuid())
  ruleId String?
  rule   AmazonAlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  /// Deterministischer Schlüssel (Regel+Ziel+Schwelle) für Deduplizierung
  dedupeKey String
  title     String
  message   String
  /// info | warning | critical
  severity  String @default("info")
  channels  String @default("inapp")
  triggeredAt    DateTime  @db.Timestamptz(3)
  acknowledgedAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([triggeredAt])
  @@index([dedupeKey, triggeredAt])
}

/// Kampagnen-/Ereignis-Annotation für Charts und Korrelationen.
model AmazonAnnotation {
  id          String   @id @default(cuid())
  timestamp   DateTime @db.Timestamptz(3)
  title       String
  description String?
  /// campaign | press | price | other
  type        String  @default("campaign")
  campaign    String?
  shortLinkId String?
  /// manual | system
  source    String   @default("manual")
  createdBy String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([timestamp])
}

/// Tägliche Zusammenfassung – höchstens 1× pro Kalendertag/Zeitzone/Empfänger.
model AmazonDigestRun {
  id           String   @id @default(cuid())
  calendarDate DateTime @db.Date
  timezone     String   @default("Europe/Berlin")
  periodStart  DateTime @db.Timestamptz(3)
  periodEnd    DateTime @db.Timestamptz(3)
  /// sent | failed | skipped
  status    String
  channel   String  @default("inapp")
  recipient String  @default("dashboard")
  sentAt    DateTime? @db.Timestamptz(3)
  /// Anteil erfolgreicher Messungen im Zeitraum (0–1)
  dataCompleteness Float?
  summary          Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@unique([calendarDate, timezone, recipient])
  @@index([calendarDate])
}

/// Externe Verkaufsschätzung (immer als Schätzung gekennzeichnet).
model AmazonSalesEstimate {
  id        String        @id @default(cuid())
  editionId String
  edition   AmazonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  provider  AmazonProviderKind
  /// z. B. "monthly"
  estimatedPeriod String
  estimateValue   Int?
  estimateLow     Int?
  estimateHigh    Int?
  confidence      String?
  methodology     String?
  observedAt      DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([editionId, observedAt])
}

/// Importierte ECHTE Verkaufszahlen (Verlag/Händler) – strikt getrennt von
/// Schätzungen, werden niemals durch Schätzwerte überschrieben.
model AmazonActualSalesImport {
  id          String        @id @default(cuid())
  editionId   String
  edition     AmazonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  units       Int
  source      String
  importedBy  String
  importedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([editionId, periodStart])
}
