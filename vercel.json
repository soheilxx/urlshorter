{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bash scripts/vercel-build.sh",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/amazon",
      "schedule": "0 6 * * *"
    }
  ]
}
