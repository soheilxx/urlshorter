# ============================================================================
# urlshorter – Environment Variables
#
# Legende:
#   [PFLICHT]    Ohne diesen Wert startet die Anwendung nicht sinnvoll.
#   [OPTIONAL]   Kann leer bleiben; zugehörige Funktion ist dann deaktiviert.
#   [GEHEIM]     Niemals committen, nur in Vercel/lokaler .env hinterlegen.
#   [ÖFFENTLICH] Unkritisch, darf im Client sichtbar sein.
# ============================================================================

# ----------------------------------------------------------------------------
# Datenbank
# ----------------------------------------------------------------------------
# [PFLICHT] [GEHEIM] PostgreSQL-Verbindung. Bei Neon/Supabase/Vercel Postgres
# die "pooled" Connection-URL verwenden (für Serverless empfohlen).
# Für Migrationen (prisma migrate deploy) ggf. die direkte URL verwenden.
DATABASE_URL="postgresql://user:password@localhost:5432/urlshorter"

# ----------------------------------------------------------------------------
# Anwendung
# ----------------------------------------------------------------------------
# [PFLICHT] [ÖFFENTLICH] Öffentliche Basis-URL der Anwendung (ohne Slash am Ende).
PUBLIC_BASE_URL="https://lizenzzumerfolg.com"

# [PFLICHT] [GEHEIM] Secret für Session-Signierung (Login-Cookies).
# Erzeugen mit:  openssl rand -hex 32   oder   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# [PFLICHT] [GEHEIM] Secret für Event-Tokens und Visitor-Hashes.
# Muss sich von AUTH_SECRET unterscheiden. Erzeugung wie oben.
APP_SECRET=""

# ----------------------------------------------------------------------------
# Admin-Zugang (keine öffentliche Registrierung)
# ----------------------------------------------------------------------------
# [PFLICHT] [GEHEIM] E-Mail-Adresse des einzigen Administrators.
ADMIN_EMAIL=""

# [PFLICHT] [GEHEIM] bcrypt-Hash des Admin-Passworts, Base64-codiert.
# Erzeugen mit:  npm run hash-password   (gibt beide Varianten aus)
# Empfohlen ist die Base64-Variante: bcrypt-Hashes enthalten "$"-Zeichen,
# die von Env-Loadern (u. a. Next.js) als Variablenreferenz interpretiert
# und dadurch zerstört werden können. Base64 ist dagegen immun.
ADMIN_PASSWORD_HASH_BASE64=""
# Alternative (nur verwenden, wenn der Wert garantiert nicht expandiert wird,
# z. B. im Vercel-Dashboard):
# ADMIN_PASSWORD_HASH=''

# ----------------------------------------------------------------------------
# Ziel-URL-Beschränkung (optionale Härtung)
# ----------------------------------------------------------------------------
# [OPTIONAL] [ÖFFENTLICH] "*" (Standard) erlaubt beliebige HTTPS-Ziel-URLs.
# Alternativ eine kommagetrennte Host-Allowlist angeben – dann sind nur diese
# Hosts (inkl. Subdomains) als Ziel erlaubt, z. B.:
#   ALLOWED_DESTINATION_HOSTS="amazon.de,www.amazon.de,amzn.eu"
# Unabhängig davon gilt immer: nur HTTPS, keine eingebetteten Zugangsdaten;
# Ziele können ausschließlich von authentifizierten Administratoren angelegt
# werden (kein Open-Redirect-Risiko).
ALLOWED_DESTINATION_HOSTS="*"

# ----------------------------------------------------------------------------
# Redirect-Verhalten
# ----------------------------------------------------------------------------
# [OPTIONAL] [ÖFFENTLICH] Verzögerung in Millisekunden, bevor die Bridge-Page
# zur Amazon-URL weiterleitet (300–2000). Kann zusätzlich im Dashboard unter
# "Einstellungen" überschrieben werden.
DEFAULT_REDIRECT_DELAY_MS=900

# ----------------------------------------------------------------------------
# Datenaufbewahrung
# ----------------------------------------------------------------------------
# [OPTIONAL] [ÖFFENTLICH] Detaillierte Click-Events werden nach dieser Anzahl
# Tage gelöscht (Tagesaggregate bleiben erhalten). Standard: 90.
EVENT_RETENTION_DAYS=90

# [PFLICHT für Cron] [GEHEIM] Secret für den Cleanup-Cron-Endpoint
# (/api/cron/cleanup). Vercel sendet es automatisch als Bearer-Token,
# wenn die Variable im Projekt hinterlegt ist.
CRON_SECRET=""

# ----------------------------------------------------------------------------
# Tracking-Integrationen (alle optional – ohne IDs ist das jeweilige
# Tracking sauber deaktiviert)
# ----------------------------------------------------------------------------
# [OPTIONAL] [ÖFFENTLICH] Google Tag Manager Container-ID, z. B. GTM-XXXXXXX
GTM_CONTAINER_ID=""

# [OPTIONAL] [ÖFFENTLICH] GA4 Measurement-ID, z. B. G-XXXXXXXXXX.
# Nur nötig, wenn GA4 OHNE GTM direkt eingebunden werden soll.
# Wenn GTM_CONTAINER_ID gesetzt ist, wird GA4 nicht zusätzlich nativ geladen
# (Vermeidung doppelter Events).
GA4_MEASUREMENT_ID=""

# [OPTIONAL] [ÖFFENTLICH] Meta (Facebook) Pixel-ID, z. B. 1234567890
META_PIXEL_ID=""

# [OPTIONAL] [ÖFFENTLICH] Reddit Pixel-ID, z. B. a2_abc123def
# Feuert "PageVisit" sowie ein Custom Event "OutboundClick" (mit conversionId
# = Event-ID für spätere Deduplication mit der Reddit Conversions API).
REDDIT_PIXEL_ID=""

# ----------------------------------------------------------------------------
# Consent (DSGVO)
# ----------------------------------------------------------------------------
# [OPTIONAL] [ÖFFENTLICH] Consent-Modus:
#   "required"     (Standard) Marketing-Pixel feuern nur bei gültigem
#                  Consent-Cookie. Ohne Consent: nur serverseitiger Click-Event,
#                  Google Consent Mode v2 auf "denied", keine Meta-Cookies.
#   "not-required" Pixel feuern immer. Nur verwenden, wenn eine eigene
#                  rechtliche Bewertung dies deckt (siehe README).
TRACKING_CONSENT_MODE="required"

# [OPTIONAL] [ÖFFENTLICH] Name des Consent-Cookies, etwa "marketing_consent".
# Die Domain lizenzzumerfolg.com wird ausschließlich für dieses Tracking-Projekt
# genutzt – der Cookie muss also auf dieser Domain (z. B. .lizenzzumerfolg.com)
# gesetzt werden, etwa durch eine vorgeschaltete Consent-Lösung.
CONSENT_COOKIE_NAME=""

# [OPTIONAL] [ÖFFENTLICH] Wert des Cookies, der als gültige Einwilligung zählt,
# z. B. "accepted" oder "1".
CONSENT_COOKIE_ACCEPTED_VALUE=""

# ----------------------------------------------------------------------------
# Rechtliches (Links auf der Weiterleitungsseite)
# ----------------------------------------------------------------------------
# [OPTIONAL] [ÖFFENTLICH] URL der Datenschutzerklärung (z. B. auf der
# Autoren-/Hauptseite gehostet)
PRIVACY_URL="https://soheil-hosseini.de/datenschutz"
# [OPTIONAL] [ÖFFENTLICH] URL des Impressums
IMPRINT_URL="https://soheil-hosseini.de/impressum"

# ----------------------------------------------------------------------------
# Bridge-Page CSP (fortgeschritten)
# ----------------------------------------------------------------------------
# [OPTIONAL] [ÖFFENTLICH] Zusätzliche Hosts (kommagetrennt), die die
# Content-Security-Policy der Weiterleitungsseite für Skripte/Pixel zulässt.
# Nur nötig, wenn über GTM weitere Drittanbieter-Tags geladen werden.
BRIDGE_EXTRA_CSP_HOSTS=""

# ----------------------------------------------------------------------------
# Monitoring (optional, Sentry vorbereitet, nicht zwingend)
# ----------------------------------------------------------------------------
# [OPTIONAL] [GEHEIM] Sentry DSN – wenn leer, ist Sentry deaktiviert.
SENTRY_DSN=""
# [OPTIONAL] [ÖFFENTLICH] Environment-Name für Sentry, z. B. "production"
SENTRY_ENVIRONMENT=""
